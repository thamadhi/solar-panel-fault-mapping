“””
Solar PV Fault Localisation and Rectification System
Environment Configuration
“””

# Application settings
APP_NAME=SolarPVFaultDetection
APP_ENV=development
LOG_LEVEL=INFO

# Paths
DATASET_PATH=data/
MODEL_PATH=models/
REPORT_OUTPUT_PATH=reports/

# Model configuration
ELECTRICAL_DETECTION_MODEL_NAME=best_neural_network
HOTSPOT_DETECTION_MODEL_NAME=hotspot_detector_v1
LOCALISATION_MODEL_NAME=panel_localiser_v1
SEVERITY_MODEL_NAME=severity_classifier_v1

# Confidence thresholds (0–100)
MIN_IMAGE_CONFIDENCE=50
MIN_READING_CONFIDENCE=50

# Feature flags
ENABLE_IMAGE_ANALYSIS=true
ENABLE_SENSOR_ANALYSIS=true

# AI Assistant
# The assistant connects to an LLM provider ONLY on the server side.
# Set AI_PROVIDER to one of:
#   openai | openai-compatible | gemini | claude | ollama
AI_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
