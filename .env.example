# Solar PV Fault Localisation and Rectification System
# Environment Configuration
#
# Copy this file to `.env` and fill in your own values:
#   cp .env.example .env
#
# IMPORTANT: `.env` must contain only valid KEY=VALUE lines. Do not include
# prose or markdown — tools like docker compose (env_file) will reject them.

# Application settings
APP_NAME=SolarPVFaultDetection
APP_ENV=development
LOG_LEVEL=INFO

# Paths
DATASET_PATH=data/
MODEL_PATH=models/
REPORT_OUTPUT_PATH=reports/

# Model configuration
ELECTRICAL_DETECTION_MODEL_NAME=best_neural_network
HOTSPOT_DETECTION_MODEL_NAME=hotspot_detector_v1
LOCALISATION_MODEL_NAME=panel_localiser_v1
SEVERITY_MODEL_NAME=severity_classifier_v1

# Confidence thresholds (0-100)
MIN_IMAGE_CONFIDENCE=50
MIN_READING_CONFIDENCE=50

# Feature flags
ENABLE_IMAGE_ANALYSIS=true
ENABLE_SENSOR_ANALYSIS=true

# Authentication
# Set a strong, unique secret in production (at least 32 random characters).
# If unset, a development fallback is used.
JWT_SECRET=change-me-to-a-long-random-string

# AI Assistant
# The assistant connects to an LLM provider ONLY on the server side.
# Set AI_PROVIDER to one of:
#   openai | openai-compatible | gemini | claude | ollama
# If unset, the chat UI works but answers with a "provider not configured"
# message. Credentials below must never be committed or shipped to the client.
AI_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local Ollama
# Local development (Flask runs on your machine): http://localhost:11434
# Dockerized API: http://host.docker.internal:11434 (macOS/Windows)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Backend API base URL used by the Streamlit app for server-side calls.
# Local: leave default. Docker: http://api:8000 (set in compose.yml).
API_BASE_URL=http://127.0.0.1:8000

# Browser-facing API URL embedded in the AI assistant widget (runs in the
# browser). Defaults to API_BASE_URL. Docker: http://localhost:8000.
WIDGET_API_BASE_URL=

# Next.js frontend (frontend/) — production deployments (e.g. Vercel)
# NEXT_PUBLIC_API_URL: optional browser-side direct URL to the API. When set
#   it is baked into the client bundle at build time (Docker sets this).
#   Leave unset on Vercel so the browser uses the same-origin /api-proxy.
# API_URL: server-side target of the /api-proxy rewrite. Set this on Vercel
#   to your deployed backend URL (e.g. https://opensunray-api.onrender.com).
# Local dev needs neither — the proxy defaults to http://127.0.0.1:8000.
NEXT_PUBLIC_API_URL=
API_URL=
