m <- 1000
mat <- matrix(NA, nrow=m, ncol=2)
x <- c(2,4,6,8,10,12)
for (i in 1:m) {
y <- 5 + 2 * x + rnorm(6,0,2)
model <- lm(y ~ x)
mat[i,1] = model$coef[1]
mat[i, 2] = model$coef[2]
}
hist(mat[,1], xlab="Histogram of b0, true value = 5")
hist(mat[,1], main= "b0",xlab="Histogram of b0, true value = 5")
